rules_version = '2';

// データ構造（docs/ARCHITECTURE.md「データモデル」参照）
//   classes/{classCode}/days/{yyyymmdd}/results/{autoId}   … 1プレイ1ドキュメント（追記のみ）
//   classes/{classCode}/days/{yyyymmdd}/presence/{uid}     … 参加状況（本人のみ書込）
// 生徒・教員とも匿名認証。ログイン不要だが、未認証の読み書きは拒否する。
service cloud.firestore {
  match /databases/{database}/documents {

    match /classes/{classCode}/days/{day}/results/{resultId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.name is string
        && request.resource.data.name.size() <= 20
        && request.resource.data.clearMs is number
        && request.resource.data.clearMs > 0
        && request.resource.data.mastered is bool
        && request.resource.data.total is number
        && request.resource.data.correct is number
        && request.resource.data.correct <= request.resource.data.total
        && request.resource.data.total <= 1000;
      allow update, delete: if false;
    }

    match /classes/{classCode}/days/{day}/presence/{uid} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.uid == uid;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
